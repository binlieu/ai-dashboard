# Kasa account email; values are read literally, without shell expansion.
KASA_EMAIL=
# Kasa account password; optional matching outer quotes are removed.
KASA_PASSWORD=
# First-run seed only; leave blank for zero cameras, or enter comma-separated MACs.
CAMERA_MACS=
# First-run display names, 1–40 characters; empty entries default to Camera N.
CAMERA_NAMES=
# First-run legacy seed for one camera, used only when CAMERA_MACS is absent.
# CAMERA_MAC=
# After data/cameras.json exists, manage cameras and layout through the local API.
# Optional local dashboard port (default 1984).
# DASHBOARD_PORT=1984
